---
import type { TermLine } from '../content';

interface Props {
  title: string;
  lines: TermLine[];
}
const { title, lines } = Astro.props;
const esc = (s: string) => s.replace(/&/g, '&amp;').replace(/</g, '&lt;').replace(/>/g, '&gt;');

// 全站唯一的 set:html 用法：内容全部来自 content.ts（本地文案，无用户输入）。
const preHtml = lines
  .map((l) => {
    if (l.cls === 'cmd') {
      const rest = l.text.replace(/^\$\s*/, '');
      return `<span class="t-cmd"><span class="p">$</span> ${esc(rest)}</span>`;
    }
    if (l.cls === 'prompt') {
      return `<span class="t-prompt"><span class="arrow">&gt;</span> ${esc(l.text)}</span>`;
    }
    return `<span class="t-${l.cls}">${esc(l.text)}</span>`;
  })
  .join('\n');
---
<div class="terminal" role="img" aria-label={title}>
  <div class="bar">
    <span class="dot r"></span><span class="dot y"></span><span class="dot g"></span>
    <span class="title">{title}</span>
  </div>
  <pre set:html={preHtml}></pre>
</div>
