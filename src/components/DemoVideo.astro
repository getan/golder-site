---
// 首屏演示视频：真实录制的 golder workspace 会话，资产在 public/demo/ 下。
interface Props {
  title: string;
  caption: string;
}
const { title, caption } = Astro.props;
---
<div class="demo">
  <div class="demo-frame">
    <div class="bar">
      <span class="dot r"></span><span class="dot y"></span><span class="dot g"></span>
      <span class="title">{title}</span>
    </div>
    <video
      controls
      playsinline
      preload="metadata"
      poster="/demo/browser-backend-poster.jpg"
      aria-label={caption}
    >
      <source src="/demo/browser-backend.mp4" type="video/mp4" />
      <source src="/demo/browser-backend.webm" type="video/webm" />
    </video>
  </div>
  <div class="demo-caption">{caption}</div>
</div>
